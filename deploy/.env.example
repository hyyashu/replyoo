# Copy to ".env" in the repo root on the server: cp deploy/.env.example .env
# Never commit the filled-in file. Generate secrets with: openssl rand -hex 32

# --- Domain -----------------------------------------------------------------
# Caddy container for HTTPS and routing. Delete this line when Dokploy (or another proxy) does that.
COMPOSE_PROFILES=caddy
# Public hostname with its DNS A record pointing at this server (no https://, no slash).
DOMAIN=app.example.com

# --- Database ---------------------------------------------------------------
# Hex only (openssl rand -hex 24): it goes into a connection URL, so no special characters.
POSTGRES_PASSWORD=

# --- Secrets ----------------------------------------------------------------
# 32+ characters.
BETTER_AUTH_SECRET=
# Encrypts stored Meta access tokens: exactly 32 random bytes, base64-encoded (openssl rand -base64 32).
# Back it up: losing it means every connected account must reconnect.
TOKEN_ENCRYPTION_KEY=
# Any random string; paste the same value into the Meta app's webhook "Verify token" field.
META_WEBHOOK_VERIFY_TOKEN=

# --- Meta -------------------------------------------------------------------
META_APP_ID=
META_APP_SECRET=
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# Optional: Facebook Login for Business configuration id.
META_LOGIN_CONFIG_ID=
META_GRAPH_VERSION=v24.0

# --- Email (required: sign-up confirmation, sign-in codes, reconnect links) --
# "resend" or "smtp". "log" is rejected in production: the worker will not start with it.
EMAIL_PROVIDER=resend
EMAIL_FROM=Replyooo <no-reply@example.com>
RESEND_API_KEY=
# For EMAIL_PROVIDER=smtp:
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=
SMTP_USER=
SMTP_PASS=

# --- Optional ---------------------------------------------------------------
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
# Billing stays off until the key and both product ids are set. Keep test_mode while testing.
DODO_API_KEY=
DODO_WEBHOOK_SECRET=
DODO_ENVIRONMENT=test_mode
DODO_PRODUCT_PRO=
DODO_PRODUCT_BUSINESS=
OUTBOUND_RATE_PER_SECOND=10
LOG_LEVEL=info
