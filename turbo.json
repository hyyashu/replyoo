{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "outputs": [
        "dist/**",
        ".next/**"
      ]
    },
    "test": {
      "passThroughEnv": [
        "TEST_DATABASE_URL",
        "DOCKER_HOST",
        "TESTCONTAINERS_*"
      ]
    },
    "typecheck": {}
  }
}
